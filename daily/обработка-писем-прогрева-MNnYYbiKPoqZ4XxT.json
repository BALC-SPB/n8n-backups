\n      return true;\n    } catch (err) {\n      console.error(`Ошибка на попытке ${attempt}:`, err.message || err);\n      imap.end();\n\n      if (attempt < maxRetries) {\n        console.log(`Жду 20 секунд перед повтором (попытка ${attempt + 1})...`);\n        await delay(20000);\n      } else {\n        console.log('Достигнут лимит попыток. Завершаю с ошибкой.');\n        return false;\n      }\n    }\n  }\n}\n\n$input.first().json.read = await markEmailReadWithRetry(5);\nreturn $input.first().json;\n"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[2944,256],"id":"c952ed4b-4781-42e5-8f4e-e9fe445e0d40","name":"Прочтение письма1","retryOnFail":true,"waitBetweenTries":3000,"maxTries":5},{"parameters":{"method":"POST","url":"http://37.18.2.51:8082/v1/read_message","sendBody":true,"bodyParameters":{"parameters":[{"name":"message_id","value":"={{ $json.message_id }}"},{"name":"exe_id","value":"={{ $execution.id }}"}]},"options":{}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[3312,0],"id":"f76b20c2-c859-4663-917e-11b67be0e4d0","name":"Обновление истории1"},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"id":"8f6c6f89-94a1-48fd-9247-4c863733749d","leftValue":"={{ $json.read }}","rightValue":"","operator":{"type":"boolean","operation":"true","singleValue":true}}],"combinator":"and"},"options":{}},"type":"n8n-nodes-base.if","typeVersion":2.2,"position":[3104,256],"id":"7a3c45eb-00d7-4578-bcd1-cd50b176b257","name":"If"},{"parameters":{"mode":"combine","combineBy":"combineByPosition","options":{}},"type":"n8n-nodes-base.merge","typeVersion":3.2,"position":[2560,416],"id":"389d3dbe-c5ae-4dcc-bb89-88bb182f10f5","name":"Merge6"},{"parameters":{"method":"POST","url":"http://37.18.2.51:8082/v1/await_read","sendBody":true,"bodyParameters":{"parameters":[{"name":"message_id","value":"={{ $json.message_id }}"},{"name":"exe_id","value":"={{ $execution.id }}"}]},"option