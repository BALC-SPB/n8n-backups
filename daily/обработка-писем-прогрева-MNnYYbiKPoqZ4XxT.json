{"id":"MNnYYbiKPoqZ4XxT","name":"Обработка писем прогрева","active":true,"activeVersionId":"a109ab75-9d4c-49f4-90ae-b50ee52e8f40","createdAt":"2026-10-16T09:19:31.164Z","updatedAt":"2026-11-16T10:57:49.220Z","isArchived":false,"versionId":"a109ab75-9d4c-49f4-90ae-b50ee52e8f40","triggerCount":0,"nodes":[{"parameters":{"jsCode":"const Imap = require('imap');\n\nconst imapUser = $input.first().json.imap_user;\nconst imapPass = $input.first().json.imap_pass;\nconst imapHost = $input.first().json.imap_host;\nconst imapPort = $input.first().json.imap_port;\nconst folder = $input.first().json.folder;\nconst uid = $input.first().json.uid;\n\nconst imapConfig = {\n  user: imapUser,\n  password: imapPass,\n  host: imapHost,\n  port: imapPort,\n  tls: true,\n};\n\n// Функция задержки\nfunction delay(ms) {\n  return new Promise(resolve => setTimeout(resolve, ms));\n}\n\nfunction connectIMAP(imap) {\n  return new Promise((resolve, reject) => {\n    imap.once('ready', resolve);\n    imap.once('error', reject);\n    imap.connect();\n  });\n}\n\nfunction openInbox(imap) {\n  return new Promise((resolve, reject) => {\n    imap.openBox(folder, false, (err, box) => {\n      if (err) {\n        reject(err);\n      } else {\n        resolve(box);\n      }\n    });\n  });\n}\n\nfunction addSeenFlag(imap, uid) {\n  return new Promise((resolve, reject) => {\n    imap.addFlags(uid, '\\\\Seen', (err) => {\n      if (err) reject(err);\n      else resolve();\n    });\n  });\n}\n\nasync function markEmailReadWithRetry(maxRetries = 5) {\n  for (let attempt = 1; attempt <= maxRetries; attempt++) {\n    const imap = new Imap(imapConfig);\n    try {\n      console.log(`Попытка ${attempt} подключения к IMAP...`);\n      await connectIMAP(imap);\n\n      console.log('Подключение успешно. Открываю папку:', folder);\n      await openInbox(imap);\n\n      console.log(`Пробую пометить письмо UID ${uid} как \\\\Seen...`);\n      await addSeenFlag(imap, uid);\n\n      console.log('Успешно! Закрываю соединение.');\n      imap.end();\n      return true;\n    } catch (err) {\n      console.error(`Ошибка на попытке ${attempt}:`, err.message || err);\n      imap.end();\n\n      if (attempt < maxRetries) {\n        console.log(`Жду 20 секунд перед повтором (попытка ${attempt + 1})...`);\n        await delay(20000);\n      } else {\n        console.log('Достигнут лимит попыток. Завершаю с ошибкой.');\n        return false;\n      }\n    }\n  }\n}\n\n$input.first().json.read = await markEmailReadWithRetry(5);\nreturn $input.first().json;\n"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[2944,256],"id":"c952ed4b-4781-42e5-8f4e-e9fe445e0d40","name":"Прочтение письма1","retryOnFail":true,"waitBetweenTries":3000,"maxTries":5},{"parameters":{"method":"POST","url":"http://37.18.2.51:8082/v1/read_message","sendBody":true,"bodyParameters":{"parameters":[{"name":"message_id","value":"={{ $json.message_id }}"},{"name":"exe_id","value":"={{ $execution.id }}"}]},"options":{}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[3312,0],"id":"f76b20c2-c859-4663-917e-11b67be0e4d0","name":"Обновление истории1"},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"id":"8f6c6f89-94a1-48fd-9247-4c863733749d","leftValue":"={{ $json.read }}","rightValue":"","operator":{"type":"boolean","operation":"true","singleValue":true}}],"combinator":"and"},"options":{}},"type":"n8n-nodes-base.if","typeVersion":2.2,"position":[3104,256],"id":"7a3c45eb-00d7-4578-bcd1-cd50b176b257","name":"If"},{"parameters":{"mode":"combine","combineBy":"combineByPosition","options":{}},"type":"n8n-nodes-base.merge","typeVersion":3.2,"position":[2560,416],"id":"389d3dbe-c5ae-4dcc-bb89-88bb182f10f5","name":"Merge6"},{"parameters":{"method":"POST","url":"http://37.18.2.51:8082/v1/await_read","sendBody":true,"bodyParameters":{"parameters":[{"name":"message_id","value":"={{ $json.message_id }}"},{"name":"exe_id","value":"={{ $e