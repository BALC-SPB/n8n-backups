роблема на таможне\",\n    \"message\": \"Груз с декларацией 1024ЗК завис на таможне в Белоруссии. Требуют дополнительное подтверждение сертификата.\",\n    \"reply\": \"Связались с брокером, они подготовят и отправят доп.подтверждение в течение часа. Держим вас в курсе.\"\n  }\n];\n\nreturn messages;"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[1200,400],"id":"2a3fad48-e886-4fc7-bd61-344e271ca30d","name":"Список сообщений"},{"parameters":{"content":"## История отправок прогрева почт","height":620,"width":720,"color":4},"type":"n8n-nodes-base.stickyNote","position":[1776,0],"typeVersion":1,"id":"2e205f23-73ac-495a-be77-07ed395388fc","name":"Sticky Note2"},{"parameters":{"url":"http://37.18.2.51:8082/v1/history","options":{"response":{"response":{"responseFormat":"json"}}}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[1856,144],"id":"bee5a601-6ae1-45df-9f84-8cb97fc4e0f6","name":"Получение всей истории отправок"},{"parameters":{"url":"http://37.18.2.51:8082/v1/history","sendQuery":true,"queryParameters":{"parameters":[{"name":"id","value":"5"}]},"options":{"response":{"response":{"responseFormat":"json"}}}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[2128,144],"id":"6768a962-804e-4055-bf75-5ac6373bb807","name":"Получение истории по ID"},{"parameters":{"method":"PUT","url":"http://37.18.2.51:8082/v1/history","sendQuery":true,"queryParameters":{"parameters":[{"name":"id","value":"10"}]},"sendBody":true,"bodyParameters":{"parameters":[{"name":"date_response","value":"18.06.2025"},{"name":"time_response","value":"12:15:30"}]},"options":{"response":{"response":{"responseFormat":"json"}}}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[2288,432],"id":"11a8466e-3911-448e-870e-8cbbdc77c069","name":"Обновление истории"},{"parameters":{"method":"POST","url":"http://37.18.2.51:8082/v1/history","sendBody":true,"bodyParameters":{"parameters":[{"name":"sender","value":"2"},{"name":"recipient","value":"3"},{